# Токен от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF

# ID администраторов через запятую (для /stats)
ADMIN_IDS=

# Необязательно: свой Telegram Bot API сервер (telegram-bot-api).
# С ним бот может отправлять файлы до 2 ГБ вместо 50 МБ и скачивать присланные файлы любого размера.
# Пример: http://telegram-bot-api:8081
TELEGRAM_API_URL=

# Необязательно: cookies.txt (формат Netscape) для Instagram / YouTube,
# нужен, если Instagram требует вход или YouTube просит "подтвердите, что вы не бот".
COOKIES_FILE=

# Прокси на случай, если сайт блокирует IP сервера. В docker-compose по умолчанию
# используется встроенный Cloudflare WARP (socks5://warp:1080), менять не нужно.
PROXY_URL=

# Сервер PO-токенов для YouTube. В docker-compose по умолчанию http://pot-provider:4416
POT_PROVIDER_URL=

# Сколько скачиваний может идти одновременно
MAX_PARALLEL_DOWNLOADS=4

# Максимальное качество видео (высота кадра)
MAX_VIDEO_HEIGHT=1080

# Где хранить временные файлы и базу
DATA_DIR=./data

# Только для своего Bot API сервера (docker compose --profile local-api up -d)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
